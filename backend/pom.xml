<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>com.adrianpmdev</groupId>
    <artifactId>ntg</artifactId>
    <version>0.1</version>
    <packaging>pom</packaging>

    <!--
        platform-api : contracts shared by core and the games (no Spring Security, no Supabase)
        core         : platform features (auth, users, tags), security and the Supabase integration
        games/*      : one module per game, each one depends only on platform-api
        app          : boots the application with core and every game, and builds the runnable jar
    -->
    <modules>
        <module>platform-api</module>
        <module>core</module>
        <module>games/pokemon</module>
        <module>games/wow-forever</module>
        <module>app</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <!-- Sources and resources are UTF-8 (Spanish texts) on every machine, not whatever the system uses -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring.boot.version>4.0.4</spring.boot.version>
        <springdoc.version>3.0.1</springdoc.version>
        <lombok.version>1.18.48</lombok.version>
        <bucket4j.version>8.21.0</bucket4j.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal modules -->
            <dependency>
                <groupId>com.adrianpmdev</groupId>
                <artifactId>platform-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.adrianpmdev</groupId>
                <artifactId>core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.adrianpmdev</groupId>
                <artifactId>pokemon</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.adrianpmdev</groupId>
                <artifactId>wow-forever</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Swagger/OpenAPI for endpoint documentation -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Lombok, available to every module at compile time only -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring.boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Tests: Mockito attaches its agent at runtime, which Java 21+ only allows when told so -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
            </plugin>

            <!-- Keeps method parameter names available at runtime for Spring and OpenAPI, and runs Lombok -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
